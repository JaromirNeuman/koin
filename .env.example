# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (AI asistent – volitelné; bez klíče běží chat v demo režimu)
OPENAI_API_KEY=your-openai-api-key
# Model pro chat. Priorita: OPENAI_MODEL > OPENAI_ESTIMATOR_MODEL > gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
OPENAI_ESTIMATOR_MODEL=gpt-4o-mini
